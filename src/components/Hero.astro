---
import BackgroundEffect from "./BackgroundEffect.astro";
import Countdown from "./Countdown.astro";

interface Props {
  launchDate: string;
}

const { launchDate } = Astro.props;
---

<main class="relative min-h-screen overflow-hidden bg-night text-white selection:bg-gold selection:text-night">
  <BackgroundEffect />

  <section class="relative z-10 flex min-h-screen items-center justify-center px-5 py-12 sm:px-8">
    <div
      id="hero-content"
      class="mx-auto flex w-full max-w-5xl flex-col items-center text-center will-change-transform"
      style="transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1), transform 0.1s ease-out;"
    >
      <!-- Eugen FnF Brand Badge -->
      <div class="mb-8 inline-flex items-center gap-4">
        <span class="h-px w-12 bg-gradient-to-r from-transparent to-gold" />
        <p class="text-sm font-black uppercase tracking-[0.42em] text-gold-soft">
          Eugen FnF
        </p>
        <span class="h-px w-12 bg-gradient-to-l from-transparent to-gold" />
      </div>

      <!-- Main Headline -->
      <h1
        id="hero-title"
        class="max-w-5xl font-sans text-5xl font-black uppercase leading-[0.92] tracking-normal text-white sm:text-7xl lg:text-8xl"
      >
        We Are Launching Soon
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 max-w-2xl text-base font-medium leading-7 text-white/70 sm:text-xl">
        Elite fitness experience is coming
      </p>

      <!-- Countdown -->
      <div class="mt-10 w-full">
        <Countdown target={launchDate} />
      </div>

      <!-- CTA Action -->
      <a
        id="hero-cta"
        href="mailto:hello@eugenfnf.com?subject=Early%20Access%20Request"
        class="mt-10 inline-flex min-h-14 items-center justify-center rounded-md border border-gold/70 bg-gold px-8 text-sm font-black uppercase tracking-[0.18em] text-black shadow-gold transition duration-300 hover:bg-gold-soft hover:shadow-[0_0_48px_rgba(212,175,55,0.58)] hover:-translate-y-0.5 active:scale-98 focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2 focus:ring-offset-night"
      >
        Join Early Access
      </a>
    </div>
  </section>
</main>

<script>
  function initParallax() {
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let animFrame = 0;

    const heroContent = document.getElementById("hero-content");
    const heroTitle = document.getElementById("hero-title");
    const bgHeroImg = document.getElementById("bg-hero-img");
    const bgRing1 = document.getElementById("bg-ring-1");
    const bgRing2 = document.getElementById("bg-ring-2");
    const bgParticles = document.getElementById("bg-particles");

    function onPointerMove(e: PointerEvent) {
      const halfW = window.innerWidth / 2;
      const halfH = window.innerHeight / 2;
      targetX = (e.clientX - halfW) / halfW;
      targetY = (e.clientY - halfH) / halfH;
    }

    function renderLoop() {
      // Smooth dampening / spring interpolation
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      // Text displacement
      const textX = currentX * 12;
      const textY = currentY * 8;
      const shadowX = currentX * -14;
      const shadowY = currentY * -10;

      if (heroContent) {
        heroContent.style.transform = `translate3d(${textX.toFixed(2)}px, ${textY.toFixed(2)}px, 0)`;
      }

      if (heroTitle) {
        heroTitle.style.textShadow = `${shadowX.toFixed(1)}px ${shadowY.toFixed(1)}px 32px rgba(212, 175, 55, 0.22)`;
      }

      // Background hero image parallax
      if (bgHeroImg) {
        const bgX = (currentX * 2.5).toFixed(2);
        const bgY = (currentY * 2.0).toFixed(2);
        bgHeroImg.style.transform = `translate3d(${bgX}%, ${bgY}%, 0) scale(1.05)`;
      }

      // Ambient rings parallax
      if (bgRing1) {
        const r1X = (currentX * 28).toFixed(2);
        const r1Y = (currentY * 18).toFixed(2);
        bgRing1.style.transform = `translate3d(${r1X}px, ${r1Y}px, 0)`;
      }

      if (bgRing2) {
        const r2X = (currentX * -21).toFixed(2);
        const r2Y = (currentY * -16.2).toFixed(2);
        bgRing2.style.transform = `translate3d(${r2X}px, ${r2Y}px, 0)`;
      }

      // Particles parallax
      if (bgParticles) {
        const pX = (currentX * -18).toFixed(2);
        const pY = (currentY * -12).toFixed(2);
        bgParticles.style.transform = `translate3d(${pX}px, ${pY}px, 0)`;
      }

      animFrame = requestAnimationFrame(renderLoop);
    }

    window.addEventListener("pointermove", onPointerMove, { passive: true });
    animFrame = requestAnimationFrame(renderLoop);

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("pointermove", onPointerMove);
      cancelAnimationFrame(animFrame);
    }, { once: true });
  }

  // Only run parallax on devices with hover/fine pointer capability
  if (typeof window !== "undefined" && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initParallax);
    } else {
      initParallax();
    }
    document.addEventListener("astro:page-load", initParallax);
  }
</script>

