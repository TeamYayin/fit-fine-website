---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Apply for Consultation & Membership | Eugen FnF">
  <div class="min-h-screen bg-premium-dark py-12 md:py-24 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    {/* Background decoration */}
    <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-gold/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto relative z-10 max-w-7xl">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center lg:items-start">
        {/* LEFT COLUMN: Consultation Info & Benefits */}
        <div class="w-full lg:w-1/2 pt-0 lg:pt-6 space-y-10">
          <div>
            <span class="text-gold uppercase tracking-[0.24em] text-xs font-semibold mb-3 block">Concierge Access</span>
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
              Begin Your <br />
              <span class="text-gold">Legacy</span>
            </h1>
            <p class="text-gray-400 text-lg max-w-lg leading-relaxed">
              Apply for a personal evaluation with our elite coaching staff. Spots are intentionally capped to ensure dedicated attention.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">Talk to Us</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  We schedule an initial intake call to understand your lifestyle, work schedule, injury history, and target outcomes.
                </p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">We Clarify Every Detail</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  No question is too granular. We demystify our metabolic programming, travel protocols, and recovery structure.
                </p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">Calibrate Your Plan</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  Together we match you with Silver, Gold, or Platinum coaching calibrated for your commitments.
                </p>
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-white/10 max-w-md">
            <p class="text-xs text-gray-500 uppercase tracking-widest font-semibold flex items-center gap-2">
              <span class="text-gold font-bold">Support Hotline:</span>
              <span class="text-white font-mono text-sm">+91 98765 00000</span>
            </p>
          </div>
        </div>

        {/* RIGHT COLUMN: Application Form */}
        <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
          <div class="w-full max-w-md bg-black border border-gold shadow-[0_0_30px_rgba(212,175,55,0.25)] p-8 rounded-2xl relative">
            <form id="contact-form" class="space-y-5">
              {/* Plan Selection */}
              <div>
                <label class="block text-sm font-bold text-white text-center mb-3">Select Desired Tier</label>
                <div class="grid grid-cols-3 gap-2" id="tier-buttons">
                  <button type="button" data-tier="Silver" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all">
                    Silver
                  </button>
                  <button type="button" data-tier="Gold" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all">
                    Gold
                  </button>
                  <button type="button" data-tier="Platinum" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all">
                    Platinum
                  </button>
                </div>
                <input type="hidden" id="selected-tier" value="Gold" />
              </div>

              {/* Form Fields */}
              <div>
                <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Full Name</label>
                <input type="text" id="contact-name" required placeholder="John Doe" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Email Address</label>
                  <input type="email" id="contact-email" required placeholder="john@example.com" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Phone Number</label>
                  <input type="tel" id="contact-phone" required placeholder="+91 98765 43210" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Preferred Date</label>
                  <input type="date" id="contact-date" required class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Preferred Time</label>
                  <select id="contact-time" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm">
                    <option value="morning">Morning (9 AM - 12 PM)</option>
                    <option value="afternoon">Afternoon (12 PM - 4 PM)</option>
                    <option value="evening">Evening (4 PM - 8 PM)</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Current Fitness Goals / Notes</label>
                <textarea id="contact-message" rows="3" placeholder="Tell us about your objectives, current routine, or challenges..." class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm"></textarea>
              </div>

              <button type="submit" id="submit-btn" class="w-full py-4 bg-gold text-black font-bold uppercase tracking-wider text-xs rounded-full hover:bg-gold-light transition-all shadow-[0_0_20px_rgba(212,175,55,0.4)]">
                Submit Consultation Request
              </button>
            </form>

            <div id="contact-success" class="mt-6 p-4 rounded-xl bg-gold/10 border border-gold text-center hidden">
              <p class="text-gold font-bold text-sm">Consultation Request Received</p>
              <p class="text-gray-300 text-xs mt-1">Our coach will reach out to you within 24 hours at your chosen time.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Tier buttons
    const tierBtns = document.querySelectorAll('.tier-btn');
    const selectedTierInput = document.getElementById('selected-tier') as HTMLInputElement | null;

    // Read query parameter if present
    const urlParams = new URLSearchParams(window.location.search);
    const planParam = urlParams.get('plan');
    if (planParam && selectedTierInput) {
      selectedTierInput.value = planParam;
      tierBtns.forEach((b) => {
        if (b.getAttribute('data-tier')?.toLowerCase() === planParam.toLowerCase()) {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all';
        } else {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all';
        }
      });
    }

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tier = btn.getAttribute('data-tier') || 'Gold';
        if (selectedTierInput) selectedTierInput.value = tier;
        tierBtns.forEach((b) => {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all';
        });
        btn.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all';
      });
    });

    // Form submission
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('contact-success');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successBox) {
        successBox.classList.remove('hidden');
        form.reset();
      }
    });
  </script>
</Layout>
