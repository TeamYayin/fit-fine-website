{
  "name": "eugen-fnf-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_FROM_EMAIL": "noreply-contact@eugenfnf.com",
    "CONTACT_RECEIVER_EMAIL": "subscriptions@eugenfnf.com",
    "PUBLIC_LAUNCH_DATE": "2026-11-11T00:00:00+05:30"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "previews": {}
}
