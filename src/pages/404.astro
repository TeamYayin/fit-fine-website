---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | Eugen FnF">
  <div class="min-h-[75vh] flex items-center justify-center bg-black px-4">
    <div class="text-center p-8 max-w-lg">
      <h1 class="text-8xl md:text-9xl font-bold text-gold mb-4 font-mono tracking-tighter">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 uppercase tracking-widest">Page Not Found</h2>
      <p class="text-gray-400 mb-8 text-base">The luxury experience you are looking for does not exist here.</p>
      <a
        href="/"
        class="inline-block bg-gold text-black px-8 py-3.5 rounded-full font-bold uppercase tracking-wider text-xs hover:bg-gold-light transition-all shadow-lg"
      >
        Return Home
      </a>
    </div>
  </div>
</Layout>
