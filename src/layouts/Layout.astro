---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Eugen FnF | Luxury Fitness & Concierge Health Coaching",
  description = "A concierge-level fitness experience where precision programming, restorative recovery, and daily rituals converge to build confident, capable bodies."
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Home", href: "/" },
  { name: "Blogs", href: "/blog" },
  { name: "Plans", href: "/plans" },
  { name: "Tools", href: "/tools" },
  { name: "Diet Plans", href: "/diet-plans" },
  { name: "FAQs", href: "/faq" },
  { name: "Contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        background-color: #000000;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Poppins', sans-serif;
      }
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #1c1c1e;
      }
      ::-webkit-scrollbar-thumb {
        background: #d4af37;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #b5952f;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-premium-black text-white selection:bg-gold selection:text-black">
    {/* Sticky Header */}
    <header class="sticky top-0 z-40 bg-premium-black/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          {/* Logo */}
          <a href="/" class="flex items-center gap-2 group">
            <div class="text-gold p-1.5 transform group-hover:rotate-12 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6.5 6.5 11 11"></path>
                <path d="m21 21-1-1"></path>
                <path d="m3 3 1 1"></path>
                <path d="m18 22 4-4"></path>
                <path d="m2 6 4-4"></path>
                <path d="m3 10 7-7"></path>
                <path d="m14 21 7-7"></path>
              </svg>
            </div>
            <span class="text-2xl font-bold tracking-tight text-white">
              Eugen<span class="text-gold"> FnF</span>
            </span>
          </a>

          {/* Desktop Navigation */}
          <nav class="hidden md:flex space-x-7">
            {navItems.map((item) => (
              <a
                href={item.href}
                class={`text-sm font-medium transition-colors uppercase tracking-wider ${
                  (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)))
                    ? 'text-gold border-b-2 border-gold pb-1'
                    : 'text-gray-400 hover:text-gold'
                }`}
              >
                {item.name}
              </a>
            ))}
          </nav>

          {/* Member Login & Mobile Toggle */}
          <div class="flex items-center gap-4">
            <button
              id="open-auth-btn"
              class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gold border border-gold/30 rounded-full hover:bg-gold hover:text-black transition-all focus:outline-none focus:ring-2 focus:ring-gold focus:ring-offset-2 focus:ring-offset-black"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="hidden sm:inline">Member Login</span>
            </button>

            <button
              id="mobile-menu-toggle"
              class="md:hidden text-gold focus:outline-none p-2"
              aria-label="Toggle navigation menu"
            >
              <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      {/* Mobile Navigation Drawer */}
      <div id="mobile-menu" class="hidden md:hidden bg-premium-dark border-t border-white/10 w-full">
        <div class="flex flex-col px-4 py-4 space-y-3">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
                currentPath === item.href ? 'text-gold bg-white/5' : 'text-gray-300 hover:text-gold hover:bg-white/5'
              }`}
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </header>

    {/* Main Content Slot */}
    <main class="flex-grow">
      <slot />
    </main>

    {/* Footer */}
    <footer class="bg-black text-white py-16 border-t-2 border-white/10 mt-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
          <div class="space-y-6">
            <div class="flex items-center gap-2">
              <div class="text-gold">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6.5 6.5 11 11"></path>
                  <path d="m21 21-1-1"></path>
                  <path d="m3 3 1 1"></path>
                  <path d="m18 22 4-4"></path>
                  <path d="m2 6 4-4"></path>
                  <path d="m3 10 7-7"></path>
                  <path d="m14 21 7-7"></path>
                </svg>
              </div>
              <span class="text-xl font-bold">
                Eugen<span class="text-gold"> FnF</span>
              </span>
            </div>
            <p class="text-gray-400 text-sm leading-relaxed">
              Elite training for those who demand excellence. Experience the pinnacle of bespoke fitness, metabolic mastery, and nutrition coaching.
            </p>
          </div>

          <div>
            <h4 class="font-bold text-lg mb-6 text-white uppercase tracking-wider text-sm">
              Quick Links
            </h4>
            <ul class="space-y-3 text-sm text-gray-400">
              <li><a href="/blog" class="hover:text-gold transition-colors">Blogs</a></li>
              <li><a href="/plans" class="hover:text-gold transition-colors">Premium Plans</a></li>
              <li><a href="/diet-plans" class="hover:text-gold transition-colors">Diet Plans</a></li>
              <li><a href="/tools" class="hover:text-gold transition-colors">Fitness Calculators</a></li>
              <li><a href="/contact" class="hover:text-gold transition-colors">Apply for Consultation</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-lg mb-6 text-white uppercase tracking-wider text-sm">
              Portals & Legal
            </h4>
            <ul class="space-y-3 text-sm text-gray-400">
              <li><a href="/admin" class="hover:text-gold transition-colors">Admin Portal</a></li>
              <li><a href="/faq" class="hover:text-gold transition-colors">Frequently Asked Questions</a></li>
              <li><a href="/contact" class="hover:text-gold transition-colors">Support & Inquiries</a></li>
              <li><span class="text-gray-600 cursor-not-allowed">Privacy Policy</span></li>
              <li><span class="text-gray-600 cursor-not-allowed">Terms of Service</span></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-lg mb-6 text-white uppercase tracking-wider text-sm">
              Connect With Us
            </h4>
            <p class="text-sm text-gray-400 mb-4">Direct concierge hotline:</p>
            <p class="text-gold font-bold text-lg mb-4">+91 98765 00000</p>
            <div class="flex space-x-3">
              <a href="#" class="text-gray-400 hover:text-black hover:bg-gold p-3 rounded-full transition-all border border-white/10" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-black hover:bg-gold p-3 rounded-full transition-all border border-white/10" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-black hover:bg-gold p-3 rounded-full transition-all border border-white/10" aria-label="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
              </a>
            </div>
          </div>
        </div>
        <div class="border-t border-white/10 mt-16 pt-8 text-center text-sm text-gray-500">
          &copy; {new Date().getFullYear()} Eugen FnF (Eugen Fit and Fine). All rights reserved.
        </div>
      </div>
    </footer>

    {/* Auth Modal */}
    <div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
      <div class="relative w-full max-w-md bg-premium-dark border border-white/10 shadow-2xl p-8 rounded-xl">
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
          <h3 id="modal-title" class="text-xl font-bold text-white uppercase tracking-wider">Member Access</h3>
          <button id="close-auth-btn" class="text-gray-400 hover:text-gold p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="flex mb-6 bg-black p-1 border border-white/10">
          <button id="tab-user" class="flex-1 py-2 text-xs font-semibold uppercase tracking-wider bg-gold text-black transition-all">
            User Login
          </button>
          <button id="tab-admin" class="flex-1 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 hover:text-white transition-all">
            Admin Login
          </button>
        </div>

        <form id="auth-form" class="space-y-5">
          <div>
            <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-2">Email Address</label>
            <input type="email" id="auth-email" required class="w-full px-4 py-3 bg-black border border-white/10 text-white focus:border-gold outline-none text-sm" placeholder="you@example.com" />
          </div>
          <div>
            <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-2">Password</label>
            <input type="password" id="auth-password" required minlength="4" class="w-full px-4 py-3 bg-black border border-white/10 text-white focus:border-gold outline-none text-sm" placeholder="••••••••" />
          </div>
          <div id="admin-hint" class="text-xs text-gray-500 italic hidden">
            Hint: admin@fitlife.com / admin
          </div>
          <button type="submit" id="auth-submit" class="w-full py-3 bg-gold text-black font-bold uppercase tracking-wider text-sm rounded-full hover:bg-gold-light transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
            Enter Dashboard
          </button>
        </form>
      </div>
    </div>

    {/* Client Scripts for Mobile Menu & Modal */}
    <script>
      // Mobile menu toggle
      const mobileToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      mobileToggle?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });

      // Auth Modal logic
      const authModal = document.getElementById('auth-modal');
      const openAuthBtn = document.getElementById('open-auth-btn');
      const closeAuthBtn = document.getElementById('close-auth-btn');
      const tabUser = document.getElementById('tab-user');
      const tabAdmin = document.getElementById('tab-admin');
      const modalTitle = document.getElementById('modal-title');
      const adminHint = document.getElementById('admin-hint');
      const authSubmit = document.getElementById('auth-submit');
      const authForm = document.getElementById('auth-form') as HTMLFormElement | null;
      let mode = 'USER';

      openAuthBtn?.addEventListener('click', () => authModal?.classList.remove('hidden'));
      closeAuthBtn?.addEventListener('click', () => authModal?.classList.add('hidden'));

      tabUser?.addEventListener('click', () => {
        mode = 'USER';
        tabUser.className = 'flex-1 py-2 text-xs font-semibold uppercase tracking-wider bg-gold text-black transition-all';
        tabAdmin?.setAttribute('class', 'flex-1 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 hover:text-white transition-all');
        if (modalTitle) modalTitle.textContent = 'Member Access';
        adminHint?.classList.add('hidden');
        if (authSubmit) authSubmit.textContent = 'Enter Dashboard';
      });

      tabAdmin?.addEventListener('click', () => {
        mode = 'ADMIN';
        tabAdmin.className = 'flex-1 py-2 text-xs font-semibold uppercase tracking-wider bg-gold text-black transition-all';
        tabUser?.setAttribute('class', 'flex-1 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 hover:text-white transition-all');
        if (modalTitle) modalTitle.textContent = 'Admin Portal';
        adminHint?.classList.remove('hidden');
        if (authSubmit) authSubmit.textContent = 'Access Panel';
      });

      authForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = (document.getElementById('auth-email') as HTMLInputElement)?.value;
        const password = (document.getElementById('auth-password') as HTMLInputElement)?.value;
        if (mode === 'ADMIN') {
          if (email === 'admin@fitlife.com' && password === 'admin') {
            authModal?.classList.add('hidden');
            window.location.href = '/admin';
          } else {
            alert('Invalid admin credentials. Try admin@fitlife.com / admin');
          }
        } else {
          alert(`Welcome back, ${email}!`);
          authModal?.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
