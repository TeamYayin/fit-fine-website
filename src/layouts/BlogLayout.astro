---
import Layout from './Layout.astro';

export interface Props {
  frontmatter?: {
    title?: string;
    excerpt?: string;
    category?: string;
    readTime?: string;
    publishDate?: string;
    author?: string;
    authorRole?: string;
    imageUrl?: string;
    tags?: string[];
  };
  title?: string;
  excerpt?: string;
  category?: string;
  readTime?: string;
  publishDate?: string;
  author?: string;
  authorRole?: string;
  imageUrl?: string;
  tags?: string[];
}

const { frontmatter } = Astro.props;

const title = frontmatter?.title || Astro.props.title || 'Editorial Article';
const excerpt = frontmatter?.excerpt || Astro.props.excerpt || '';
const category = frontmatter?.category || Astro.props.category || 'Workout & Training';
const readTime = frontmatter?.readTime || Astro.props.readTime || '6 min read';
const publishDate = frontmatter?.publishDate || Astro.props.publishDate || 'October 12, 2026';
const author = frontmatter?.author || Astro.props.author || 'Eugen FnF Master Coach';
const authorRole = frontmatter?.authorRole || Astro.props.authorRole || 'Senior Performance & Nutrition Specialist';
const imageUrl = frontmatter?.imageUrl || Astro.props.imageUrl || 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1200&q=80';
const tags = frontmatter?.tags || Astro.props.tags || [];
---

<Layout title={`${title} | Eugen FnF Editorial`}>
  <article class="min-h-screen bg-premium-black text-white pb-24">
    {/* Top Header / Breadcrumb Section */}
    <header class="pt-12 pb-10 bg-gradient-to-b from-premium-dark to-premium-black border-b border-white/5 relative">
      <div class="absolute inset-0 bg-[radial-gradient(#D4AF37_1px,transparent_1px)] [background-size:24px_24px] opacity-5 pointer-events-none"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl relative z-10">
        {/* Navigation Breadcrumb */}
        <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-gray-400 mb-6 font-mono">
          <a href="/" class="hover:text-gold transition-colors">Home</a>
          <span class="text-white/30">/</span>
          <a href="/blog" class="hover:text-gold transition-colors">Editorial</a>
          <span class="text-white/30">/</span>
          <span class="text-gold truncate">{category}</span>
        </nav>

        {/* Category Pill */}
        <div class="mb-4">
          <span class="inline-block px-3.5 py-1 bg-gold/10 border border-gold/40 text-gold text-[10px] font-bold uppercase tracking-widest rounded-full">
            {category}
          </span>
        </div>

        {/* Title */}
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white leading-tight tracking-tight mb-6">
          {title}
        </h1>

        {/* Meta Bar */}
        <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-white/10 text-xs text-gray-400">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gold/20 border border-gold/40 flex items-center justify-center text-gold font-bold text-sm">
              {author.charAt(0)}
            </div>
            <div>
              <div class="font-bold text-white text-sm">{author}</div>
              <div class="text-[11px] text-gray-400">{authorRole}</div>
            </div>
          </div>

          <div class="flex items-center gap-4 text-xs font-mono text-gray-400">
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              {publishDate}
            </span>
            <span class="text-white/20">•</span>
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {readTime}
            </span>
          </div>
        </div>
      </div>
    </header>

    {/* Hero Image & Lead Container */}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl mt-8">
      {/* Featured Image */}
      {imageUrl && (
        <div class="relative w-full h-64 sm:h-80 md:h-[440px] rounded-2xl overflow-hidden border border-white/10 shadow-[0_0_40px_rgba(0,0,0,0.8)] mb-10 group">
          <img
            src={imageUrl}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
        </div>
      )}

      {/* Lead Summary Excerpt */}
      {excerpt && (
        <div class="mb-10 p-6 rounded-xl bg-gold/5 border-l-4 border-gold border-y border-r border-white/5">
          <p class="text-xs uppercase tracking-widest text-gold font-bold mb-2">Executive Summary</p>
          <p class="text-gray-200 text-base md:text-lg italic leading-relaxed">
            "{excerpt}"
          </p>
        </div>
      )}

      {/* Main Markdown Content Body */}
      <div class="prose-luxury">
        <slot />
      </div>

      {/* Tags if available */}
      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-white/10 flex flex-wrap items-center gap-2">
          <span class="text-xs uppercase tracking-wider text-gray-500 font-bold mr-2">Topics:</span>
          {tags.map((tag: string) => (
            <span class="px-3 py-1 bg-white/5 border border-white/10 text-gray-300 rounded-full text-xs hover:border-gold/50 transition-colors">
              #{tag}
            </span>
          ))}
        </div>
      )}

      {/* Author Bio Card */}
      <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-premium-dark to-black border border-white/10 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-xl">
        <div class="w-16 h-16 rounded-full bg-gold/20 border-2 border-gold flex items-center justify-center text-gold text-2xl font-bold shrink-0">
          {author.charAt(0)}
        </div>
        <div class="text-center sm:text-left flex-1">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <div>
              <h3 class="text-lg font-bold text-white">{author}</h3>
              <p class="text-xs text-gold uppercase tracking-wider">{authorRole}</p>
            </div>
            <a
              href="/contact"
              class="inline-block text-xs uppercase tracking-widest text-gold border border-gold/40 px-3 py-1.5 rounded-full hover:bg-gold hover:text-black transition-all font-semibold"
            >
              Consult with Coach
            </a>
          </div>
          <p class="text-gray-400 text-sm leading-relaxed">
            Coaching high-performing individuals at Eugen Fit & Fine. Specializes in progressive overload architectures, metabolic reconditioning, and bio-individuality protocols.
          </p>
        </div>
      </div>

      {/* Luxury Coaching Concierge Callout */}
      <div class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-[#161618] via-[#0E0E10] to-[#080808] border border-gold/30 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute top-0 right-0 w-64 h-64 bg-gold/5 blur-[90px] rounded-full pointer-events-none"></div>
        <span class="text-gold uppercase tracking-[0.2em] text-xs font-semibold block mb-2">Individualized Protocol</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          Turn Knowledge Into Measurable Transformation
        </h2>
        <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
          Reading is the blueprint; execution requires individualized calibration. Apply for a private consultation with our performance team to tailor this strategy to your schedule and physiology.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contact?plan=Gold"
            class="px-8 py-3.5 bg-gold text-black font-bold uppercase tracking-wider text-xs rounded-full hover:bg-gold-light transition-all shadow-[0_0_20px_rgba(212,175,55,0.3)] w-full sm:w-auto"
          >
            Apply for Coaching
          </a>
          <a
            href="/plans"
            class="px-8 py-3.5 bg-black/60 border border-white/20 text-white font-bold uppercase tracking-wider text-xs rounded-full hover:border-gold hover:text-gold transition-all w-full sm:w-auto"
          >
            Explore 45-Day Plans
          </a>
        </div>
      </div>

      {/* Bottom Back Button */}
      <div class="mt-12 text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-xs uppercase font-bold tracking-widest text-gray-400 hover:text-gold transition-colors py-2 px-4 rounded-full border border-white/5 hover:border-gold/30"
        >
          &larr; Return to Editorial Hub
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Markdown Typography Styling */
  .prose-luxury {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #D1D5DB;
  }

  .prose-luxury :global(h2) {
    color: #FFFFFF;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
  }

  .prose-luxury :global(h3) {
    color: #D4AF37;
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-luxury :global(h4) {
    color: #FFFFFF;
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose-luxury :global(p) {
    margin-bottom: 1.5rem;
    color: #D1D5DB;
  }

  .prose-luxury :global(strong) {
    color: #FFFFFF;
    font-weight: 600;
  }

  .prose-luxury :global(a) {
    color: #D4AF37;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }

  .prose-luxury :global(a:hover) {
    color: #F3E5AB;
  }

  .prose-luxury :global(ul) {
    list-style-type: disc;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }

  .prose-luxury :global(ol) {
    list-style-type: decimal;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }

  .prose-luxury :global(li) {
    margin-bottom: 0.6rem;
    line-height: 1.7;
    color: #D1D5DB;
  }

  .prose-luxury :global(li::marker) {
    color: #D4AF37;
  }

  .prose-luxury :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.75rem;
    border-left: 3px solid #D4AF37;
    background: rgba(212, 175, 55, 0.05);
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: #F3F4F6;
  }

  .prose-luxury :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose-luxury :global(code) {
    background: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #D4AF37;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .prose-luxury :global(pre) {
    background: #121214;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }

  .prose-luxury :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: #E4E4E7;
  }

  .prose-luxury :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 3rem 0;
  }

  .prose-luxury :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose-luxury :global(th) {
    background: #18181B;
    color: #D4AF37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  .prose-luxury :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #D1D5DB;
  }

  .prose-luxury :global(tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.02);
  }
</style>
