---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Apply for Consultation & Membership | Eugen FnF">
  <div class="min-h-screen bg-premium-dark py-12 md:py-24 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    {/* Background decoration */}
    <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-gold/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto relative z-10 max-w-7xl">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center lg:items-start">
        {/* LEFT COLUMN: Consultation Info & Benefits */}
        <div class="w-full lg:w-1/2 pt-0 lg:pt-6 space-y-10">
          <div>
            <span class="text-gold uppercase tracking-[0.24em] text-xs font-semibold mb-3 block">Concierge Access</span>
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
              Begin Your <br />
              <span class="text-gold">Legacy</span>
            </h1>
            <p class="text-gray-400 text-lg max-w-lg leading-relaxed">
              Apply for a personal evaluation with our elite coaching staff. Spots are intentionally capped to ensure dedicated attention.
            </p>
          </div>

          <div class="space-y-8">
            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">Talk to Us</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  We schedule an initial intake call to understand your lifestyle, work schedule, injury history, and target outcomes.
                </p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" x2="12.01" y1="17" y2="17"></line></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">We Clarify Every Detail</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  No question is too granular. We demystify our metabolic programming, travel protocols, and recovery structure.
                </p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="bg-black border border-gold/30 p-4 rounded-full text-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-xl mb-1">Calibrate Your Plan</h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  Together we match you with Silver, Gold, or Platinum coaching calibrated for your commitments.
                </p>
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-white/10 max-w-md">
            <p class="text-xs text-gray-500 uppercase tracking-widest font-semibold flex items-center gap-2">
              <span class="text-gold font-bold">Support Hotline:</span>
              <span class="text-white font-mono text-sm">+91 98765 00000</span>
            </p>
          </div>
        </div>

        {/* RIGHT COLUMN: Application Form */}
        <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
          <div class="w-full max-w-md bg-black border border-gold shadow-[0_0_30px_rgba(212,175,55,0.25)] p-8 rounded-2xl relative">
            <form id="contact-form" class="space-y-5">
              {/* Bot Honeypot (Hidden) */}
              <input type="text" id="contact-honeypot" name="_honeypot" class="hidden" tabindex="-1" autocomplete="off" />

              {/* Plan Selection */}
              <div>
                <label class="block text-sm font-bold text-white text-center mb-3">Select Desired Tier</label>
                <div class="grid grid-cols-3 gap-2" id="tier-buttons">
                  <button type="button" data-tier="Silver" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all">
                    Silver
                  </button>
                  <button type="button" data-tier="Gold" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all">
                    Gold
                  </button>
                  <button type="button" data-tier="Platinum" class="tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all">
                    Platinum
                  </button>
                </div>
                <input type="hidden" id="selected-tier" value="Gold" />
              </div>

              {/* Form Fields */}
              <div>
                <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Full Name</label>
                <input type="text" id="contact-name" required placeholder="John Doe" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Email Address</label>
                  <input type="email" id="contact-email" required placeholder="john@example.com" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm" />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Phone Number</label>
                  <input type="tel" id="contact-phone" required placeholder="+91 98765 43210" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm transition-colors" />
                  <p id="phone-error" class="text-xs text-red-400 mt-1 hidden">Please enter a valid 10 to 15 digit phone number (e.g. +91 98765 43210).</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="relative">
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Preferred Date</label>
                  <button
                    type="button"
                    id="cal-trigger-btn"
                    class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm flex items-center justify-between text-left hover:border-gold/50 transition-colors"
                  >
                    <span id="cal-selected-display" class="text-gray-400">Select consultation date</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </button>
                  <input type="hidden" id="contact-date" name="callbackDate" required />
                  <p id="date-error" class="text-xs text-red-400 mt-1 hidden">Please select a valid upcoming date.</p>

                  {/* Custom Calendar Dropdown */}
                  <div id="cal-popover" class="hidden absolute top-full left-0 z-50 mt-2 w-72 bg-[#121214] border border-gold/30 rounded-xl p-4 shadow-2xl backdrop-blur-md">
                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-white/10">
                      <button type="button" id="cal-prev-month" class="p-1 text-gray-400 hover:text-gold rounded transition-colors disabled:opacity-20 disabled:cursor-not-allowed">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </button>
                      <span id="cal-month-year" class="text-xs font-bold text-white uppercase tracking-wider">Month Year</span>
                      <button type="button" id="cal-next-month" class="p-1 text-gray-400 hover:text-gold rounded transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>

                    <div class="grid grid-cols-7 gap-1 text-center mb-2">
                      <span class="text-[10px] font-bold text-gold/70">Su</span>
                      <span class="text-[10px] font-bold text-gold/70">Mo</span>
                      <span class="text-[10px] font-bold text-gold/70">Tu</span>
                      <span class="text-[10px] font-bold text-gold/70">We</span>
                      <span class="text-[10px] font-bold text-gold/70">Th</span>
                      <span class="text-[10px] font-bold text-gold/70">Fr</span>
                      <span class="text-[10px] font-bold text-gold/70">Sa</span>
                    </div>

                    <div id="cal-days-grid" class="grid grid-cols-7 gap-1 text-xs">
                      {/* Days rendered via client script */}
                    </div>
                  </div>
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Preferred Time</label>
                  <select id="contact-time" class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm">
                    <option value="Morning (9 AM - 12 PM)">Morning (9 AM - 12 PM)</option>
                    <option value="Afternoon (12 PM - 4 PM)">Afternoon (12 PM - 4 PM)</option>
                    <option value="Evening (4 PM - 8 PM)">Evening (4 PM - 8 PM)</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gold uppercase tracking-widest mb-1.5">Current Fitness Goals / Notes</label>
                <textarea id="contact-message" rows="3" placeholder="Tell us about your objectives, current routine, or challenges..." class="w-full px-4 py-3 bg-black border border-white/10 rounded-lg text-white focus:border-gold outline-none text-sm"></textarea>
              </div>

              <button type="submit" id="submit-btn" class="w-full py-4 bg-gold text-black font-bold uppercase tracking-wider text-xs rounded-full hover:bg-gold-light transition-all shadow-[0_0_20px_rgba(212,175,55,0.4)] disabled:opacity-50 disabled:cursor-not-allowed">
                Submit Consultation Request
              </button>
            </form>

            {/* Success Box */}
            <div id="contact-success" class="mt-6 p-5 rounded-xl bg-gold/10 border border-gold text-center hidden">
              <div class="text-gold font-bold text-sm flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>Consultation Request Received</span>
              </div>
              <p class="text-gray-300 text-xs mt-2 leading-relaxed">
                Our coach will reach out to you within 24 hours at your chosen callback window.
              </p>
            </div>

            {/* Error Box */}
            <div id="contact-error" class="mt-6 p-4 rounded-xl bg-red-950/60 border border-red-500/50 text-center hidden">
              <p class="text-red-400 font-bold text-xs" id="contact-error-text">Failed to submit request.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Tier buttons pre-selection
    const tierBtns = document.querySelectorAll('.tier-btn');
    const selectedTierInput = document.getElementById('selected-tier') as HTMLInputElement | null;

    const urlParams = new URLSearchParams(window.location.search);
    const planParam = urlParams.get('plan');
    if (planParam && selectedTierInput) {
      selectedTierInput.value = planParam;
      tierBtns.forEach((b) => {
        if (b.getAttribute('data-tier')?.toLowerCase() === planParam.toLowerCase()) {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all';
        } else {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all';
        }
      });
    }

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tier = btn.getAttribute('data-tier') || 'Gold';
        if (selectedTierInput) selectedTierInput.value = tier;
        tierBtns.forEach((b) => {
          b.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 border-white/10 hover:border-gold hover:text-white transition-all';
        });
        btn.className = 'tier-btn py-3 px-2 border rounded-lg text-xs font-bold uppercase tracking-wider bg-gold text-black border-gold shadow-md transition-all';
      });
    });

    // --- Custom Calendar Picker Component Logic ---
    const calTriggerBtn = document.getElementById('cal-trigger-btn');
    const calPopover = document.getElementById('cal-popover');
    const calMonthYear = document.getElementById('cal-month-year');
    const calDaysGrid = document.getElementById('cal-days-grid');
    const calPrevMonth = document.getElementById('cal-prev-month') as HTMLButtonElement | null;
    const calNextMonth = document.getElementById('cal-next-month') as HTMLButtonElement | null;
    const contactDateInput = document.getElementById('contact-date') as HTMLInputElement | null;
    const calSelectedDisplay = document.getElementById('cal-selected-display');
    const dateError = document.getElementById('date-error');

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    let currentView = new Date(today.getFullYear(), today.getMonth(), 1);
    let selectedDateIso = '';

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!calMonthYear || !calDaysGrid) return;
      const viewYear = currentView.getFullYear();
      const viewMonth = currentView.getMonth();

      calMonthYear.textContent = `${monthNames[viewMonth]} ${viewYear}`;

      // Disable prev button if view is currently in current month or earlier
      if (calPrevMonth) {
        const isCurrentOrPastMonth =
          viewYear < today.getFullYear() ||
          (viewYear === today.getFullYear() && viewMonth <= today.getMonth());
        calPrevMonth.disabled = isCurrentOrPastMonth;
      }

      calDaysGrid.innerHTML = '';

      const firstDayIdx = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      // Empty leading slots
      for (let i = 0; i < firstDayIdx; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'p-1';
        calDaysGrid.appendChild(emptyCell);
      }

      // Day buttons
      for (let day = 1; day <= daysInMonth; day++) {
        const cellDate = new Date(viewYear, viewMonth, day);
        cellDate.setHours(0, 0, 0, 0);
        const isoString = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

        const dayBtn = document.createElement('button');
        dayBtn.type = 'button';
        dayBtn.textContent = String(day);

        if (cellDate < today) {
          dayBtn.disabled = true;
          dayBtn.className = 'w-full py-1.5 text-center text-xs text-gray-600 opacity-25 cursor-not-allowed';
        } else {
          if (isoString === selectedDateIso) {
            dayBtn.className = 'w-full py-1.5 text-center text-xs font-bold bg-gold text-black rounded shadow-md';
          } else {
            dayBtn.className = 'w-full py-1.5 text-center text-xs text-gray-300 hover:bg-gold/20 hover:text-gold rounded transition-colors';
          }

          dayBtn.addEventListener('click', () => {
            selectedDateIso = isoString;
            if (contactDateInput) contactDateInput.value = isoString;
            if (calSelectedDisplay) {
              calSelectedDisplay.textContent = cellDate.toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              });
              calSelectedDisplay.className = 'text-white font-medium text-sm';
            }
            dateError?.classList.add('hidden');
            calPopover?.classList.add('hidden');
            renderCalendar();
          });
        }

        calDaysGrid.appendChild(dayBtn);
      }
    }

    renderCalendar();

    calTriggerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      calPopover?.classList.toggle('hidden');
    });

    calPrevMonth?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentView.setMonth(currentView.getMonth() - 1);
      renderCalendar();
    });

    calNextMonth?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentView.setMonth(currentView.getMonth() + 1);
      renderCalendar();
    });

    document.addEventListener('click', (e) => {
      if (!calPopover?.contains(e.target as Node) && !calTriggerBtn?.contains(e.target as Node)) {
        calPopover?.classList.add('hidden');
      }
    });

    // --- Phone Number Real-time Validation ---
    const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
    const phoneError = document.getElementById('phone-error');

    function isValidPhoneNumber(phone: string): boolean {
      const clean = phone.replace(/[\s\-\(\)\.]/g, '');
      return /^\+?[0-9]{10,15}$/.test(clean);
    }

    phoneInput?.addEventListener('input', () => {
      const val = phoneInput.value.trim();
      if (val.length > 0) {
        if (isValidPhoneNumber(val)) {
          phoneError?.classList.add('hidden');
          phoneInput.classList.remove('border-red-500');
        } else {
          phoneError?.classList.remove('hidden');
          phoneInput.classList.add('border-red-500');
        }
      } else {
        phoneError?.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
      }
    });

    // --- Form submission via Cloudflare Pages Function /api/contact ---
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const successBox = document.getElementById('contact-success');
    const errorBox = document.getElementById('contact-error');
    const errorText = document.getElementById('contact-error-text');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      successBox?.classList.add('hidden');
      errorBox?.classList.add('hidden');

      const phoneVal = phoneInput?.value || '';
      if (!isValidPhoneNumber(phoneVal)) {
        phoneError?.classList.remove('hidden');
        phoneInput?.classList.add('border-red-500');
        phoneInput?.focus();
        return;
      }

      const chosenDate = contactDateInput?.value;
      if (!chosenDate || new Date(chosenDate) < today) {
        dateError?.classList.remove('hidden');
        calPopover?.classList.remove('hidden');
        return;
      }

      const payload = {
        fullName: (document.getElementById('contact-name') as HTMLInputElement)?.value,
        email: (document.getElementById('contact-email') as HTMLInputElement)?.value,
        phone: phoneVal,
        plan: selectedTierInput?.value || 'Gold',
        callbackDate: chosenDate,
        callbackTime: (document.getElementById('contact-time') as HTMLSelectElement)?.value,
        message: (document.getElementById('contact-message') as HTMLTextAreaElement)?.value,
        _honeypot: (document.getElementById('contact-honeypot') as HTMLInputElement)?.value,
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Transmitting Request...';
      }

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          successBox?.classList.remove('hidden');
          form.reset();
          selectedDateIso = '';
          if (contactDateInput) contactDateInput.value = '';
          if (calSelectedDisplay) {
            calSelectedDisplay.textContent = 'Select consultation date';
            calSelectedDisplay.className = 'text-gray-400';
          }
          renderCalendar();
        } else {
          let msg = data.error || (res.status === 404 ? 'API endpoint /api/contact not found (404).' : `Server error (${res.status}): Please check server configuration.`);
          if (data.details) {
            try {
              const parsed = JSON.parse(data.details);
              if (parsed.message) msg += ` — ${parsed.message}`;
            } catch (_) {
              msg += ` — ${data.details}`;
            }
          }
          if (errorText) errorText.textContent = msg;
          console.error('Contact submission error:', res.status, data);
          errorBox?.classList.remove('hidden');
        }
      } catch (err: any) {
        console.error('Network error during contact submission:', err);
        if (errorText) errorText.textContent = 'Network error reaching submission server: ' + (err?.message || 'Please check connection.');
        errorBox?.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Consultation Request';
        }
      }
    });
  </script>
</Layout>
