---
const lifestyleFits = [
  {
    title: 'Workday Flow',
    copy: 'Desk-friendly mobility, posture resets, and focused sessions that fit into real calendars.',
  },
  {
    title: 'Family Rhythm',
    copy: 'Energy to show up fully—without sacrificing dinners, school runs, or weekends away.',
  },
  {
    title: 'Travel Proof',
    copy: 'Hotel, home, or on the move—portable protocols keep you aligned anywhere.',
  },
];
---

<section class="py-24 bg-premium-black">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="text-gold uppercase tracking-[0.24em] text-xs font-semibold mb-4">
        Lifestyle Integration
      </p>
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-4">
        Fitness that bends with your schedule, not against it.
      </h2>
      <p class="text-gray-400 text-base md:text-lg leading-relaxed">
        Your routines, obligations, and ambitions inform every adjustment—so health becomes effortless.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {lifestyleFits.map((item) => (
        <div class="bg-premium-dark/70 border border-white/10 rounded-2xl p-8 hover:border-gold/60 hover:-translate-y-1 transition-all duration-300">
          <div class="flex items-center gap-3 text-gold mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span class="text-sm uppercase tracking-[0.18em] font-bold">
              {item.title}
            </span>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm md:text-base">{item.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

